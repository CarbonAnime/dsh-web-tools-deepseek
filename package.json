{
  "name": "dsh-web-tools-deepseek",
  "version": "0.2.0",
  "description": "DeepSeek native Search/Fetch API providers for the DSH web seam — Rust engine, billed per successful call (¥5 / 1,000)",
  "keywords": [
    "dsh",
    "deepseek",
    "cordis",
    "plugin",
    "web-search",
    "web-fetch",
    "rust"
  ],
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "bin",
    "crates",
    "Cargo.toml",
    "Cargo.lock",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "CarbonAnime",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarbonAnime/dsh-web-tools-deepseek.git"
  },
  "bugs": {
    "url": "https://github.com/CarbonAnime/dsh-web-tools-deepseek/issues"
  },
  "homepage": "https://github.com/CarbonAnime/dsh-web-tools-deepseek#readme",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build:engine": "cargo build --release",
    "stage:engine": "node scripts/stage-engine.mjs",
    "build": "npm run build:engine && npm run stage:engine",
    "test": "node test/unit.mjs && node test/engine.mjs && node test/smoke.mjs",
    "test:unit": "node test/unit.mjs",
    "test:engine": "node test/engine.mjs",
    "test:smoke": "node test/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  }
}
